manufacturers_string = "Volkswagen, Toyota, Ford Motor, Honda, Chevrolet"
manufacturers = manufacturers_string.split(", ")

print(f"There are {len(manufacturers)} manufacturers in the list.")
print("Manufacturers in reverse order:", sorted(manufacturers, reverse=True))

with_letter_o = [name for name in manufacturers if "o" in name.lower()]
without_letter_i = [name for name in manufacturers if "i" not in name.lower()]
print(f"Manufacturers with the letter 'o': {len(with_letter_o)}")
print(f"Manufacturers without the letter 'i': {len(without_letter_i)}")


duplicate_manufacturers = [
	"Honda",
	"Volkswagen",
	"Toyota",
	"Ford Motor",
	"Honda",
	"Chevrolet",
	"Toyota",
]

unique_manufacturers = list(dict.fromkeys(duplicate_manufacturers))
print("\nCompanies without duplicates:")
print(", ".join(unique_manufacturers))
print(f"There are now {len(unique_manufacturers)} companies in the list.")

reversed_names = [name[::-1] for name in sorted(unique_manufacturers)]
print("\nManufacturers sorted A-Z with reversed names:")
print(", ".join(reversed_names))
