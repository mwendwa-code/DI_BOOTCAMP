<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f6f2">
    <title><%= title %> | Fact Feed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      :root {
        color-scheme: light;
        --ink: #202b25;
        --muted: #66736b;
        --green: #176b4a;
        --line: #d9e0d9;
        --paper: #f4f6f2;
      }
      body {
        min-height: 100vh;
        color: var(--ink);
        background-color: var(--paper);
        background-image: radial-gradient(#dce3db 0.7px, transparent 0.7px);
        background-size: 18px 18px;
      }
      .navbar { background: #202b25; }
      .navbar-brand { color: #fff; font-family: Georgia, serif; font-size: 1.35rem; }
      .navbar-brand:hover { color: #d1e4d6; }
      .nav-link { color: #e4ebe5; }
      .nav-link:hover, .nav-link:focus { color: #fff; }
      .page-wrap { width: min(100% - 2rem, 980px); margin-inline: auto; }
      .page-title { font-family: Georgia, serif; font-weight: 500; letter-spacing: 0; }
      .feed-post { border: 1px solid var(--line); border-left: 4px solid var(--green); border-radius: 4px; background: #fff; }
      .feed-post h2 { font-family: Georgia, serif; font-size: 1.35rem; }
      .feed-post a { color: var(--green); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .post-meta { color: var(--muted); font-size: .9rem; }
      .search-panel { border-bottom: 1px solid var(--line); }
      .form-control, .form-select { min-height: 42px; border-color: #b8c4ba; }
      .btn-primary { border-color: var(--green); background: var(--green); }
      .btn-primary:hover { border-color: #10543a; background: #10543a; }
      .site-footer { border-top: 1px solid var(--line); color: var(--muted); }
    </style>
  </head>
  <body>