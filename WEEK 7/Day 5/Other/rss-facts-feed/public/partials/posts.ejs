<div class="d-grid gap-3">
  <% if (posts && posts.length) { %>
    <% posts.forEach((post) => { %>
      <article class="feed-post p-3 p-md-4">
        <h2 class="mb-2"><a href="<%= post.link %>" rel="noopener noreferrer" target="_blank"><%= post.title %></a></h2>
        <p class="post-meta mb-3">
          <time><%= post.pubDate || 'Publication date unavailable' %></time>
          <span aria-hidden="true"> · </span>
          <span>By <%= post.creator %></span>
          <% if (post.categories.length) { %>
            <span aria-hidden="true"> · </span>
            <span><%= post.categories.join(', ') %></span>
          <% } %>
        </p>
        <p class="mb-0"><%= post.content || 'No content available.' %></p>
      </article>
    <% }) %>
  <% } %>
</div>